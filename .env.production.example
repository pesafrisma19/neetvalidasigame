# Backend Production Environment Configuration for VPS
PORT=3001
NODE_ENV=production

# Supabase PostgreSQL Direct Connection Placeholder (NEVER PUT REAL CREDENTIALS IN .EXAMPLE FILES)
DATABASE_URL="postgresql://username:password@your-db-host:5432/database_name?schema=public"

# JWT Authentication Secrets (MANDATORY: Server will fail startup if missing or < 16 chars. Must be strong & unique)
JWT_SECRET="YOUR_PRODUCTION_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS"
JWT_REFRESH_SECRET="YOUR_PRODUCTION_RANDOM_REFRESH_KEY_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Allowed CORS Origins (Vercel Frontend Domain & Custom Domain)
CORS_ORIGIN="https://neetvalidasigame.vercel.app,https://api.neetflix.monster,https://neetflix.monster,http://localhost:5173"
